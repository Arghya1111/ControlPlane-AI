# ==============================================================================
# ControlPlane.ai — Backend Environment Variables Configuration
# ==============================================================================

# Anthropic Claude API Key for AI-as-a-Judge evaluation (Required for Claude rubric)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Allowed CORS Origins (comma-separated list of origins for frontend access)
# For local development: http://localhost:3000
# For production: https://your-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Database Connection URL (Optional)
# Default is local SQLite: sqlite:///./controlplane.db
# For persistent production deployment on Render Postgres / external DB:
# DATABASE_URL=postgresql://user:password@host:5432/controlplane_db
DATABASE_URL=sqlite:///./controlplane.db

# Server Port (Render injects $PORT automatically; for local test simulation)
PORT=8000
